        <mxCell id="v46" value="&lt;b&gt;Frontend workload objects&lt;/b&gt;&lt;br&gt;• Deployment: &lt;b&gt;training-mgmt-app&lt;/b&gt; (replicas 2, topologySpread across AZs)&lt;br&gt;• HPA: &lt;b&gt;training-mgmt-app-hpa&lt;/b&gt; (min 2 · max 10 · CPU 70%)&lt;br&gt;• ConfigMap: &lt;b&gt;training-app-config&lt;/b&gt; → TRAINING_API_URL=https://api.training.internal&lt;br&gt;• Secret: &lt;b&gt;training-app-secrets&lt;/b&gt; (OIDC client secret, mTLS cert)&lt;br&gt;• NetworkPolicy: egress only to training-api-internal-lb :443 + kube-dns&lt;br&gt;• Stateless — no PersistentVolumes (use emptyDir for temp/cache)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFFDE7;strokeColor=#C9B458;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=11;" vertex="1" parent="v8">
          <mxGeometry x="20" y="700" width="910" height="180" as="geometry" />
        </mxCell>
        <mxCell id="v47" value="&lt;b&gt;Option B (recommended for production): Managed databases in private DB subnets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;RDS / Aurora · Azure Database · Cloud SQL — Multi-AZ, automated backups, PITR, encryption at rest. Reached from Training pods via ExternalName Services / secrets.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#FFF5F5;strokeColor=#B85450;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=12;container=1;collapsible=0;" vertex="1" parent="v6">
